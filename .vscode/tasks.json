{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and create medium",
            "type": "shell",
            "command": "make all install",
            "problemMatcher": []
        },
        {
            "label": "Launch QEMU",
            "type": "shell",
            "command": "make all install && qemu-system-x86_64 -S -gdb tcp::1234 -boot d -cdrom ./media/efi_grub_cdrom.iso -m 512 -daemonize",
        },
        {
            "label": "Launch VBOX",
            "type": "shell",
            "command": "make all install && VirtualBoxVM --startvm \"StapelOS\" --debug-command-line ",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Launch QEMU with USB",
            "type": "shell",
            "command": "make all install && sudo qemu-system-x86_64 -boot order=d -device qemu-xhci,id=xhci -device usb-host,bus=xhci.0,vendorid=0x0951,productid=0x1666 -drive if=pflash,format=raw,readonly=on,file=/usr/share/ovmf/OVMF.fd"
        }
    ]
}