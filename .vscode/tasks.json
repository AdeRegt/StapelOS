{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and create medium",
            "type": "shell",
            "command": "make all install",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Launch QEMU",
            "type": "shell",
            "command": "qemu-system-x86_64 -S -gdb tcp::1234 -boot d -cdrom ./media/efi_grub_cdrom.iso -m 512 -daemonize"
        }
    ]
}